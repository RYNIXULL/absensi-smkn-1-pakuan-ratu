# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absensi_db?schema=public

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_placeholder
JWT_REFRESH_SECRET=your_super_secret_refresh_key_placeholder
ACCESS_TTL=15m
REFRESH_TTL=7d

# Initial Operator Seed
SEED_OPERATOR_ID=OP001
SEED_OPERATOR_NAME=Administrator Operator
SEED_OPERATOR_PASSWORD=OperatorPassword123!

# Attendance & Anti-Fraud Rules
ATTENDANCE_MAX_ACCURACY_M=50
OPEN_BEFORE_MIN=10
LATE_AFTER_MIN=15
INTEGRITY_ENFORCE=false
PLAY_PACKAGE_NAME=com.absensi.app
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_NUMBER=
SPEED_CHECK_ENFORCE=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Leave & Export
LEAVE_MAX_BACKDATE_DAYS=3
EXPORT_MAX_RANGE_DAYS=31
EXPORT_LINK_TTL_HOURS=168
